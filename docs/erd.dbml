// NafaIQ — DBML (Database Markup Language) for dbdiagram.io
// Last updated: 2026-07-07
// Source of truth: supabase/migrations/*.sql
// Renders at https://dbdiagram.io/d

Project nafaiq {
  database_type: 'PostgreSQL'
  Note: '''
    NafaIQ — PSX trading terminal + personal finance + AI tutor
    Auth: Supabase (auth.users managed)
    Existing tables: 15 (PSX) + 1 (auth) + 1 (profiles) = 17
    Planned tables: 24 across Phases 4-9
  '''
}

// =====================================================
// AUTH & PROFILE  [🟢 EXISTS]
// =====================================================

Table auth_users [headercolor: #5d4037] {
  id uuid [pk, note: 'Supabase auth UUID']
  email text [not null]
  raw_user_meta_data jsonb
  created_at timestamptz [not null, default: `now()`]
  Note: 'Managed by Supabase Auth — triggers handle profile creation'
}

Table profiles [headercolor: #1565c0] {
  id uuid [pk, ref: > auth_users.id, note: '1:1 with auth.users; CASCADE']
  display_name text
  plan text [not null, default: `'Free'`, note: 'Free|Pro|Premium|Admin']
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Auto-created on auth.users insert via handle_new_user() trigger'
}

// =====================================================
// PSX MARKET DATA  [🟢 EXISTS, 9 tables]
// Public read, service_role writes
// =====================================================

Table psx_market_snapshot [headercolor: #2e7d32] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  symbol text [not null, unique, note: 'UNIQUE — canonical symbol (not PK)']
  price numeric(12,2)
  change numeric(12,2)
  change_pct numeric(8,4)
  volume bigint [default: 0]
  day_high numeric(12,2)
  day_low numeric(12,2)
  refreshed_at timestamptz [not null, default: `now()`]
  indexes { (symbol) [name: 'idx_psx_ms_sym'] }
  indexes { (refreshed_at DESC) [name: 'idx_psx_ms_refreshed'] }
  Note: 'Realtime-enabled via ALTER PUBLICATION supabase_realtime'
}

Table psx_ohlcv [headercolor: #2e7d32] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  symbol text [not null, note: '⚠️ no FK to psx_market_snapshot']
  date date [not null]
  open numeric(12,2) [default: 0]
  high numeric(12,2) [default: 0]
  low numeric(12,2) [default: 0]
  close numeric(12,2) [default: 0]
  volume bigint [default: 0]
  indexes { (symbol, date) [unique, name: 'idx_psx_ohlcv_sym_date'] }
  Note: 'Daily OHLCV history (~10y/symbol)'
}

Table psx_fundamentals [headercolor: #2e7d32] {
  symbol text [pk, note: 'PK = symbol (1:1 with snapshot)']
  eps numeric(12,2)
  pe numeric(8,2)
  pb numeric(8,2)
  div_yield numeric(8,4)
  payout numeric(8,4)
  roe numeric(8,4)
  refreshed_at timestamptz [not null, default: `now()`]
  Note: 'Public read; service_role writes'
}

Table psx_profile [headercolor: #2e7d32] {
  symbol text [pk]
  name text [not null, default: `''`]
  sector text
  listed_shares bigint
  free_float bigint
  refreshed_at timestamptz [not null, default: `now()`]
  Note: 'Company profile (sector, shares, free float)'
}

Table psx_announcements [headercolor: #2e7d32] {
  id text [pk, note: 'Source-system ID from DPS']
  symbol text [note: '⚠️ NULLABLE in current migration; no FK']
  posted_at timestamptz [not null, default: `now()`]
  title text [not null, default: `''`]
  category text
  url text
  body_cached text
  refreshed_at timestamptz [not null, default: `now()`]
  indexes { (symbol, posted_at DESC) [name: 'idx_psx_ann_sym'] }
  indexes { (posted_at DESC) [name: 'idx_psx_ann_posted'] }
  Note: 'Corporate announcements'
}

Table psx_dividends [headercolor: #2e7d32] {
  announcement_id text [pk]
  symbol text [not null, note: '⚠️ no FK to psx_market_snapshot']
  ex_date date
  announcement_date date
  payout_type text
  per_share numeric(10,4)
  bonus_pct numeric(10,4)
  refreshed_at timestamptz [not null, default: `now()`]
  indexes { (symbol, ex_date DESC) [name: 'idx_psx_div_sym'] }
}

Table psx_index_eod [headercolor: #2e7d32] {
  code text [not null, note: 'KSE100|KSE30|KMI30|ALLSHR']
  date date [not null]
  close numeric(12,2) [default: 0]
  volume bigint
  indexes { (code, date) [pk] }
  indexes { (code, date) [name: 'idx_psx_idx_code'] }
  Note: 'Composite PK: (code, date)'
}

Table psx_ticks [headercolor: #2e7d32] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  symbol text [not null]
  time timestamptz [not null, default: `now()`]
  price numeric(12,2)
  volume bigint [default: 0]
  created_at timestamptz [not null, default: `now()`]
  indexes { (symbol, time DESC) [name: 'idx_psx_tick_sym_time'] }
  Note: 'REPLICA IDENTITY FULL — required for Realtime broadcast'
}

Table psx_signals [headercolor: #2e7d32] {
  symbol text [pk, unique, note: 'PK and UNIQUE']
  signal text [not null, note: '⚠️ no CHECK in SQL — values: STRONG BUY|BUY|HOLD|SELL|STRONG SELL']
  confidence numeric(5,2) [not null]
  probabilities jsonb
  features_used text[]
  model_version text
  predicted_at timestamptz [not null, default: `now()`]
  indexes { (confidence DESC) [name: 'idx_psx_signals_confidence'] }
  indexes { (predicted_at DESC) [name: 'idx_psx_signals_predicted'] }
  Note: 'ML signal cache (4h TTL)'
}

// =====================================================
// USER PSX (RLS, per-user)  [🟢 EXISTS]
// v1 (psx_*, composite PK) + v2 (user_*/price_*, surrogate bigint id) coexist
// =====================================================

Table psx_watchlist_v1 [headercolor: #6a1b9a] {
  user_id uuid [pk, ref: > auth_users.id, note: 'FK ON DELETE CASCADE; part of composite PK']
  symbol text [pk, note: 'Part of composite PK']
  created_at timestamptz [not null, default: `now()`]
  Note: 'v1 — superseded by user_watchlist'
}

Table psx_alerts_v1 [headercolor: #6a1b9a] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  user_id uuid [ref: > auth_users.id, note: 'FK ON DELETE CASCADE; nullable in SQL']
  symbol text [not null]
  type text [not null, note: 'v1: type column (price/volume/etc)']
  condition text [not null]
  threshold numeric(12,4)
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, symbol) [name: 'idx_psx_alerts_user'] }
  Note: 'v1 — superseded by price_alerts (renamed threshold→price, dropped type)'
}

Table user_watchlist [headercolor: #6a1b9a] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  user_id uuid [not null, ref: > auth_users.id, note: 'FK ON DELETE CASCADE']
  symbol text [not null]
  added_at timestamptz [not null, default: `now()`]
  indexes { (user_id) [name: 'idx_user_watchlist_user'] }
  indexes { (user_id, symbol) [unique] }
  Note: 'v2 — current production watchlist'
}

Table price_alerts [headercolor: #6a1b9a] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  user_id uuid [not null, ref: > auth_users.id, note: 'FK ON DELETE CASCADE']
  symbol text [not null]
  condition text [not null, note: 'CHECK IN (above,below,cross_above,cross_below)']
  price numeric(14,2) [not null]
  enabled boolean [not null, default: true]
  triggered_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id) [name: 'idx_price_alerts_user'] }
  indexes { (enabled) [name: 'idx_price_alerts_enabled', note: 'partial index WHERE enabled = true'] }
  Note: 'v2 — current production alerts'
}

Table psx_portfolios [headercolor: #6a1b9a] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  user_id uuid [ref: > auth_users.id, note: 'FK ON DELETE CASCADE; nullable in SQL']
  name text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table psx_holdings [headercolor: #6a1b9a] {
  id bigint [pk, note: 'GENERATED BY DEFAULT AS IDENTITY']
  portfolio_id bigint [ref: > psx_portfolios.id, note: 'FK ON DELETE CASCADE; nullable in SQL']
  symbol text [not null]
  shares bigint [not null, default: 0]
  avg_cost numeric(12,2) [not null, default: 0]
  purchased_at date
  indexes { (portfolio_id, symbol) [unique] }
  Note: 'RLS: joins parent portfolio for user ownership'
}

// =====================================================
// PLANNED: FINANCE MODULE (Phase 4)  [🟡 PLANNED]
// =====================================================

Table finance_accounts [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  name text [not null, note: 'Cash, Bank, Wallet, etc.']
  type text [not null, note: 'cash|bank|wallet|crypto|investment']
  balance numeric [not null, default: 0]
  currency text [not null, default: `'PKR'`]
  created_at timestamptz [not null, default: `now()`]
}

Table finance_categories [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  name text [not null]
  icon text
  color text
  kind text [not null, note: 'income|expense']
  created_at timestamptz [not null, default: `now()`]
}

Table finance_transactions [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  account_id bigint [not null, ref: > finance_accounts.id]
  category_id bigint [not null, ref: > finance_categories.id]
  amount numeric [not null]
  direction text [not null, note: 'income|expense|transfer']
  occurred_at timestamptz [not null, default: `now()`]
  description text
  merchant text
  symbol text [ref: > psx_market_snapshot.symbol, note: 'optional — links investment txns to PSX']
  tags text[]
  receipt_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (user_id, occurred_at DESC) }
  indexes { (category_id, occurred_at DESC) }
  Note: 'Planned Phase 4'
}

Table finance_budgets [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  category_id bigint [not null, ref: > finance_categories.id]
  month date [not null, note: 'First day of month']
  limit_amount numeric [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, category_id, month) [unique] }
}

Table finance_bills [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  name text [not null, note: 'K-Electric, Internet, etc.']
  amount numeric [not null]
  frequency text [not null, note: 'monthly|weekly|quarterly|yearly']
  next_due date [not null]
  category_id bigint [not null, ref: > finance_categories.id]
  merchant text
  auto_pay boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table finance_goals [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  name text [not null, note: 'Hajj, Emergency Fund, etc.']
  target_amount numeric [not null]
  current_amount numeric [not null, default: 0]
  target_date date
  icon text
  created_at timestamptz [not null, default: `now()`]
}

Table finance_contributions [headercolor: #00838f] {
  id bigint [pk]
  goal_id bigint [not null, ref: > finance_goals.id]
  amount numeric [not null]
  note text
  contributed_at timestamptz [not null, default: `now()`]
}

Table finance_zakat_calculations [headercolor: #00838f] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  year int [not null]
  cash_on_hand numeric [not null, default: 0]
  receivables numeric [not null, default: 0]
  investments numeric [not null, default: 0]
  inventory numeric [not null, default: 0]
  liabilities numeric [not null, default: 0]
  nisab_threshold numeric [not null]
  zakat_due numeric [not null]
  calculated_at timestamptz [not null, default: `now()`]
  indexes { (user_id, year) [unique] }
}

// =====================================================
// PLANNED: NOTIFICATIONS (Phase 4)  [🟡 PLANNED]
// =====================================================

Table user_notification_prefs [headercolor: #c62828] {
  user_id uuid [pk, ref: > auth_users.id]
  email_alerts boolean [not null, default: true]
  push_alerts boolean [not null, default: true]
  in_app_alerts boolean [not null, default: true]
  email_bills boolean [not null, default: true]
  email_budgets boolean [not null, default: true]
  email_goals boolean [not null, default: true]
}

Table in_app_notifications [headercolor: #c62828] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  kind text [not null, note: 'price_alert|bill|budget|goal|system']
  title text [not null]
  body text [not null]
  link text
  read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, read, created_at DESC) }
}

Table push_subscriptions [headercolor: #c62828] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  endpoint text [not null]
  p256dh text [not null]
  auth text [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Web Push API subscription keys'
}

// =====================================================
// PLANNED: FX + PORTFOLIO (Phase 5)  [🟡 PLANNED]
// =====================================================

Table fx_rates [headercolor: #5e35b1] {
  base text [pk, note: 'PKR|USD|AED|SAR|EUR|GBP']
  quote text [pk]
  date date [pk]
  rate numeric [not null]
  Note: 'Daily refresh from SBP'
}

// =====================================================
// PLANNED: AI (Phase 6)  [🟡 PLANNED]
// =====================================================

Table ai_usage [headercolor: #ad1457] {
  user_id uuid [pk, ref: > auth_users.id]
  day date [pk]
  tutor_count int [not null, default: 0]
  report_count int [not null, default: 0]
  tokens_used int [not null, default: 0]
  Note: 'Daily counter per user for plan quota enforcement'
}

Table ai_chat_history [headercolor: #ad1457] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  lesson_id text [note: 'Nullable — free-form chat allowed']
  role text [not null, note: 'user|assistant|system']
  content text [not null]
  tokens_used int
  model text
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, lesson_id, created_at DESC) }
}

Table ai_reports [headercolor: #ad1457] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  kind text [not null, note: 'portfolio|finance|stock|market_brief']
  title text [not null]
  content text [not null]
  context jsonb
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, kind, created_at DESC) }
}

// =====================================================
// PLANNED: BILLING (Phase 8)  [🟡 PLANNED]
// =====================================================

Table subscriptions [headercolor: #d84315] {
  id bigint [pk]
  user_id uuid [not null, unique, ref: > auth_users.id]
  stripe_customer_id text [unique]
  stripe_subscription_id text [unique]
  plan text [not null, note: 'Free|Pro|Premium']
  status text [not null, note: 'active|trialing|past_due|canceled|incomplete|incomplete_expired|unpaid']
  current_period_start timestamptz
  current_period_end timestamptz
  cancel_at_period_end boolean [not null, default: false]
  canceled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Stripe webhook mirror — Stripe is source of truth'
}

Table invoices [headercolor: #d84315] {
  id bigint [pk]
  user_id uuid [not null, ref: > auth_users.id]
  stripe_invoice_id text [unique]
  amount_paid numeric
  currency text
  status text
  hosted_url text
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, created_at DESC) }
}

Table stripe_events [headercolor: #d84315] {
  stripe_event_id text [pk]
  type text [not null]
  data jsonb [not null]
  received_at timestamptz [not null, default: `now()`]
  Note: 'Webhook audit log — service_role only, no RLS'
}

// =====================================================
// PLANNED: AUDIT / FLAGS (Phase 9)  [🟡 PLANNED]
// =====================================================

Table audit_log [headercolor: #424242] {
  id bigint [pk]
  actor_id uuid [ref: > auth_users.id, note: 'Nullable — system actions have no actor']
  action text [not null]
  entity_type text
  entity_id bigint
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
  indexes { (actor_id, created_at DESC) }
  Note: 'Service-role only — no RLS'
}

Table feature_flags [headercolor: #424242] {
  key text [pk]
  enabled boolean [not null, default: false]
  rules jsonb
  updated_at timestamptz [not null, default: `now()`]
}

Table error_events [headercolor: #424242] {
  id bigint [pk]
  source text [not null, note: 'frontend|backend|api']
  level text [not null, note: 'info|warning|error|fatal']
  message text [not null]
  context jsonb
  request_id text
  created_at timestamptz [not null, default: `now()`]
  indexes { (created_at DESC) }
  Note: 'Optional Sentry mirror — service_role only'
}

// =====================================================
// DECLARED FKs (existing in SQL)
// =====================================================

Ref: auth_users.id > profiles.id [delete: cascade]
Ref: auth_users.id > psx_watchlist_v1.user_id [delete: cascade]
Ref: auth_users.id > psx_alerts_v1.user_id [delete: cascade]
Ref: auth_users.id > user_watchlist.user_id [delete: cascade]
Ref: auth_users.id > price_alerts.user_id [delete: cascade]
Ref: auth_users.id > psx_portfolios.user_id [delete: cascade]
Ref: psx_portfolios.id > psx_holdings.portfolio_id [delete: cascade]
