.superpowers/

# Claude Code local state (settings, plugin cache, transcripts).
# Ignore the CONTENTS, not the directory: git cannot re-include a path inside an
# excluded directory, so a bare `.claude/` would make the negation below a no-op
# and the shared team skills would stay untracked.
.claude/*
!.claude/skills/
.claude/skills/**/node_modules/
frontend/packages/*/.claude/settings.local.json
.zcode/

# Generated learn corpus (regenerated by backend ingestion — see frontend/packages/shared/scripts/export-learn-corpus.ts)
backend/data/

# Design docs, specs, plans, and mockups (not part of the shipped app)
docs/
AI FEATURE PLANS.md
Ai features/

# Session / context reports (local-only, not part of the shipped app)
CONTEXT.md
context.md

# Signals V2 generated caches & training scratch (regenerated by the pipeline)
backend/artifacts/signals/feature_store/
backend/artifacts/signals/feature_store_full/
backend/artifacts/signals/backtests/
backend/catboost_info/

# AI tooling dirs (not project code)
.agents/
.codex/
