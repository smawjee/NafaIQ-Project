# NafaIQ Python API — Environment Variables
# Copy this to .env and fill in values. .env is git-ignored.
#
# 4-key convention (2026-07-07):
#   *_PUBLISHABLE_KEY  -> new sb_publishable_xxx (client-side, anon role)
#   *_ANON_KEY         -> old anon JWT (legacy client-side, anon role)
#   *_SECRET_KEY       -> new sb_secret_xxx (server-side, service_role) [primary]
#   *_SERVICE_ROLE_KEY -> old service_role JWT (server-side, service_role) [legacy alias]

# =============================================================================
# Supabase URL
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co

# =============================================================================
# Server-side keys (service_role — bypasses RLS)
# =============================================================================
# Primary: new sb_secret_xxx
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Legacy alias: old JWT
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt-here

# =============================================================================
# Client-side keys (anon role — for parity with the frontend)
# =============================================================================
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-here

# =============================================================================
# Project ref + script-specific aliases
# =============================================================================
SUPABASE_PROJECT_ID=your-project-ref
PSX_SUPABASE_URL=https://your-project-ref.supabase.co
PSX_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt-here

# =============================================================================
# PSX data sources (defaults are the public endpoints)
# =============================================================================
AHLETRADE_BASE_URL=http://feed.ahletrade.com/HTTPFeedServer/FeedFetcher
DPS_BASE_URL=https://dps.psx.com.pk

# =============================================================================
# Server
# =============================================================================
LOG_LEVEL=INFO
PORT=8000
# Which duties this process runs. Leave unset (="all") for a single box that
# both serves the API and runs the scheduler — the default, unchanged behaviour.
# To split on Railway: set the API service to "web" and add a second service
# (same image) set to "worker". A Postgres advisory lock ensures only one
# scheduler ever runs, so the split can't double- or zero-run the jobs.
#   all | web | worker
# PROCESS_ROLE=all

# Keep-alive: the always-on worker pings this URL every few minutes so Railway
# can't cold-start the API after an idle gap (a cold boot pays the numpy/pandas
# import + DB reflection = a slow first load). Set to the API service's public
# URL; leave blank to disable. Set this on the WORKER service.
# API_KEEPALIVE_URL=https://<your-api>.up.railway.app
# KEEPALIVE_INTERVAL_MINUTES=4

# =============================================================================
# API authentication — shared bearer token
# =============================================================================
# NOT a secret. The web app ships this as VITE_PSX_API_TOKEN and Vite inlines
# every VITE_-prefixed var into the public browser bundle, so anyone can read
# it in DevTools. It is a coarse filter, never an authorization boundary.
PSX_API_TOKEN=generate-with-python-secrets-token-urlsafe-32

# =============================================================================
# Signals V2 training / backtesting
# =============================================================================
# Laptop-safe defaults are intentionally conservative. On a stronger machine,
# run scripts/signals/run_signals_v2_pipeline.ps1 -Mode Full to increase these.
SIGNALS_V2_MAX_ROWS_PER_SYMBOL=420
SIGNALS_V2_SAMPLE_STRIDE=20
# Optional: reuse precomputed feature datasets between training/backtest runs.
# SIGNALS_V2_FEATURE_STORE_DIR=artifacts/signals/feature_store_full

# Backend-only token for admin/write endpoints (currently POST /api/funds/import,
# which writes with the service-role key, so RLS is no backstop).
# REQUIRED for those endpoints — they fail closed with 503 when it is unset.
# Never give this a VITE_ alias and never put it in a frontend .env.
PSX_ADMIN_TOKEN=generate-with-python-secrets-token-urlsafe-32

# =============================================================================
# Outbound alert/activity email delivery
# =============================================================================
# Preferred no-domain/testing path: Brevo transactional email API with a
# verified sender. Provider options: auto, brevo, resend.
EMAIL_DELIVERY_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=your-verified-sender@example.com
BREVO_FROM_NAME=NafaIQ Alerts
# Optional domain-verified fallback:
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@nafaiq.app

# =============================================================================
# Pakistan bullion prices (Monetary Desk + Zakat)
# =============================================================================
# BACKEND-ONLY. Used for structured Sarafa.pk city-wise gold/silver rates.
# Do not add this to Vercel or any VITE_/EXPO_PUBLIC_ frontend env.
SARAFA_API_KEY=your-sarafa-api-key
SARAFA_CITY_SLUG=karachi
SARAFA_CLIENT_PLATFORM=server

# =============================================================================
# SQLAlchemy Core direct database access (transaction pooler)
# =============================================================================
SUPABASE_DATABASE_PASSWORD=your-database-password-from-supabase-dashboard
SUPABASE_POOLER_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER=postgres.your-project-ref

# =============================================================================
# AI tutor (Phase 6) — get free keys from Google AI Studio and console.groq.com
# =============================================================================
# These keys are BACKEND-ONLY (set them in Railway / your local .env). They must
# never be exposed to a client bundle — no VITE_/EXPO_PUBLIC_ prefixed copies.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
#
# Optional spare keys for free-tier quota fallback: comma-separated, tried in
# order after the singular key above. When a key returns 429 (quota/rate limit)
# or turns out to be dead (401/403), the backend rotates to the next one, so a
# spent free tier doesn't take the AI features down. Leave blank to keep the
# existing single-key behaviour.
# GEMINI_API_KEYS=your-second-gemini-key,your-third-gemini-key,your-fourth-gemini-key
# GROQ_API_KEYS=your-second-groq-key,your-third-groq-key,your-fourth-groq-key
# optional overrides
# AI_TUTOR_MODEL_PRIMARY=gemini-3.1-flash-lite  # 500 req/day free vs 20/day on mainline Flash
# AI_TUTOR_MODEL_FALLBACK=llama-3.3-70b-versatile
# AI_TUTOR_REQUEST_TIMEOUT_S=30

# =============================================================================
# Bank-email transaction import (Gmail API, read-only OAuth)
# Full setup guide: docs/email-import-setup.md
# =============================================================================
# Kill switch — poller stays off and /connect returns 503 unless true
EMAIL_IMPORT_ENABLED=false
# Fernet key: encrypts each user's Google refresh token at rest + signs the
# OAuth state. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it invalidates every stored grant (users must reconnect).
EMAIL_CRED_ENC_KEY=
# Google Cloud Console > Credentials > OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered in the console. Google allows
# https:// or http://localhost only — never a LAN IP, so mobile must use the
# deployed backend URL.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
# Where the OAuth callback returns a web user to
WEB_APP_ORIGIN=http://localhost:3000
# optional overrides
# EMAIL_POLL_INTERVAL_MINUTES=5
# EMAIL_IMPORT_MAX_LLM_PER_POLL=20

# =============================================================================
# Langfuse LLM observability (optional) — traces every LLM call
# Get keys from your Langfuse project > Settings > API Keys. Leave blank to
# disable (tracing becomes a no-op). Set LANGFUSE_HOST to your region's host
# shown on the API-keys page (EU default; JP/US differ).
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
