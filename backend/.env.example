# NafaIQ Python API — Environment Variables
# Copy this to .env and fill in values. .env is git-ignored.
#
# 4-key convention (2026-07-07):
#   *_PUBLISHABLE_KEY  -> new sb_publishable_xxx (client-side, anon role)
#   *_ANON_KEY         -> old anon JWT (legacy client-side, anon role)
#   *_SECRET_KEY       -> new sb_secret_xxx (server-side, service_role) [primary]
#   *_SERVICE_ROLE_KEY -> old service_role JWT (server-side, service_role) [legacy alias]

# =============================================================================
# Supabase URL
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co

# =============================================================================
# Server-side keys (service_role — bypasses RLS)
# =============================================================================
# Primary: new sb_secret_xxx
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Legacy alias: old JWT
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt-here

# =============================================================================
# Client-side keys (anon role — for parity with the frontend)
# =============================================================================
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-here

# =============================================================================
# Project ref + script-specific aliases
# =============================================================================
SUPABASE_PROJECT_ID=your-project-ref
PSX_SUPABASE_URL=https://your-project-ref.supabase.co
PSX_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt-here

# =============================================================================
# PSX data sources (defaults are the public endpoints)
# =============================================================================
AHLETRADE_BASE_URL=http://feed.ahletrade.com/HTTPFeedServer/FeedFetcher
DPS_BASE_URL=https://dps.psx.com.pk

# =============================================================================
# Server
# =============================================================================
LOG_LEVEL=INFO
PORT=8000

# =============================================================================
# API authentication — shared bearer token
# =============================================================================
PSX_API_TOKEN=generate-with-python-secrets-token-urlsafe-32

# =============================================================================
# SQLAlchemy Core direct database access (transaction pooler)
# =============================================================================
SUPABASE_DATABASE_PASSWORD=your-database-password-from-supabase-dashboard
SUPABASE_POOLER_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER=postgres.your-project-ref
