# NafaIQ Frontend — Environment Variables
# Copy this to .env and fill in values. .env is git-ignored.
#
# 4-key convention (2026-07-07):
#   *_PUBLISHABLE_KEY  -> new sb_publishable_xxx (client-side, anon role)
#   *_ANON_KEY         -> old anon JWT (legacy client-side, anon role)
#   *_SECRET_KEY       -> new sb_secret_xxx (server-side, service_role)
#   *_SERVICE_ROLE_KEY -> old service_role JWT (server-side, service_role)

# =============================================================================
# Supabase URL
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# =============================================================================
# Client / browser context (anon role)
# =============================================================================
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-here

# =============================================================================
# Server / SSR context (service_role)
# =============================================================================
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt-here

# =============================================================================
# Project ref
# =============================================================================
VITE_SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PROJECT_ID=your-project-ref

# =============================================================================
# Python API URL
# =============================================================================
VITE_PSX_API_URL=http://localhost:8000
VITE_PSX_API_TOKEN=generate-with-python-secrets-token-urlsafe-32
PSX_API_URL=http://localhost:8000

# =============================================================================
# Demo account (used by "Try Demo" button — set these for your demo user)
# =============================================================================
VITE_DEMO_EMAIL=demo@nafaiq.com
VITE_DEMO_PASSWORD=your-demo-password-here

# =============================================================================
# Lovable AI Gateway (required for AI tutor)
# =============================================================================
LOVABLE_API_KEY=your-lovable-api-key
