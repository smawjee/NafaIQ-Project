# NafaIQ Frontend Environment Variables
# Copy this file to .env and fill in the values for your local dev environment.
# All values MUST be safe to ship to the browser (anon / publishable only).
# Never put service_role or service key here.

# Supabase (anon / publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: legacy JWT-format anon key (read for parity)
VITE_SUPABASE_ANON_KEY=

# Backend API
# Public URL of the FastAPI backend (Python PSX API service)
# Set this to your Railway backend URL in production
VITE_API_URL=http://localhost:8000
# Legacy alias (fallback if VITE_API_URL is not set)
VITE_PSX_API_URL=
# Optional shared token for public PSX routes (market snapshot, indicators, etc.)
# In production this is a service-role token. Keep blank in dev unless you have one.
VITE_PSX_API_TOKEN=

# Demo user (used by the Try Demo button on the landing page)
# The demo user must already exist in your Supabase auth.users table.
VITE_DEMO_EMAIL=demo@nafaiq.com
# Set to the demo user's password to enable the Try Demo button on the landing page.
# For security, this should match the demo user's actual Supabase Auth password.
VITE_DEMO_PASSWORD=
