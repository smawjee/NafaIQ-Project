{
  "expo": {
    "name": "nafa-iq-mobile",
    "slug": "nafa-iq-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nafaiqmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nafaiq.mobile"
    },
    "android": {
      "package": "com.nafaiq.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D1424",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050816",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "NafaIQ uses the microphone for voice commands to the assistant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
