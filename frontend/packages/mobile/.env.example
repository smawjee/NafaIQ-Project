# Copy to .env.local and fill in. Expo only exposes EXPO_PUBLIC_* to the client.
# Use the SAME Supabase project your web app / Vercel uses (the one with Google
# OAuth configured). The ANON key is the publishable (sb_publishable_) key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# FastAPI backend base URL (no trailing slash). Leave blank in dev: the app
# auto-derives it from the Metro host (http://<metro-host>:8000), which works
# on emulators and physical devices alike. Production builds MUST set this.
EXPO_PUBLIC_API_URL=

# Optional shared bearer token for the PUBLIC market/reference routes
# (/api/market, /api/symbols, ...). Leave blank if the backend does not
# require one. User-owned routes always use the Supabase session JWT instead.
EXPO_PUBLIC_PSX_API_TOKEN=

# Server-only (DO NOT prefix EXPO_PUBLIC). Used by the AI-tutor Edge Function,
# never shipped in the app bundle:
# LOVABLE_API_KEY=...
