# Copy to .env.local and fill in. Expo only exposes EXPO_PUBLIC_* to the client.
# Use the SAME Supabase project your web app / Vercel uses (the one with Google
# OAuth configured). The ANON key is the publishable (sb_publishable_) key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only (DO NOT prefix EXPO_PUBLIC). Used by the AI-tutor Edge Function,
# never shipped in the app bundle:
# LOVABLE_API_KEY=...
